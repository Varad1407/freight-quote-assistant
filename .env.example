# Copy to .env and adjust. Never commit .env.

# Which AI to use: "ollama" (free, runs on your Mac), "groq" (free hosted API) or "anthropic" (needs an API key)
LLM_PROVIDER=ollama

# Ollama settings (default provider)
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_URL=http://localhost:11434

# Anthropic settings (only used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Groq settings (only used when LLM_PROVIDER=groq). Free key: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Public demo limits (0 = off). Per visitor per hour, and total per 24 hours.
RATE_LIMIT_PER_HOUR=10
RATE_LIMIT_PER_DAY_TOTAL=300

LOG_LEVEL=INFO

# Mailbox worker (python -m app.mailbox). Use a TEST account, never your personal inbox.
# IMAP_PASSWORD is a Google "app password" (16 characters, no spaces), not your normal password.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=
# Optional: IMAP_FOLDER=INBOX, IMAP_SINCE_DAYS=7, IMAP_DRAFTS_FOLDER (detected automatically)
